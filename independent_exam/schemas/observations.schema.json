{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgk.invalid/schemas/observations-v1.json",
  "title": "MGK v0.1.0 independent observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate", "contract_sha256", "suites", "metrics",
    "checks", "mutation_score_percent", "clean_install", "reproducibility",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "mgk.observations.v1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_sha256", "commit_sha"],
      "properties": {
        "version": {"const": "0.1.0"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "suites": {"type": "object"},
    "metrics": {"type": "object"},
    "checks": {"type": "object"},
    "mutation_score_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "clean_install": {"type": "object"},
    "reproducibility": {"type": "object"},
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}

